# RetroChat — environment variables.
# Copy this file to `.env.local` for local dev (gitignored), and configure
# the same vars in the Vercel dashboard for production deployment.

# Default upstream for the built-in "Preset" option in Settings.
# Used by api/chat.js when the request body has no baseUrl/apiKey — i.e.
# whenever the user leaves the preset selected. All three are required for
# the preset to work; change any of them from the Vercel dashboard and the
# preset picks it up on the next request, no client update needed.
PRESET_BASE_URL=https://api.example.com/v1
PRESET_API_KEY=sk-your-key-here
PRESET_MODEL=your-model-id

# Optional: extra origins allowed to call /api/chat from a browser.
# Same-origin (your Vercel deploy) and localhost are always allowed.
# Add custom domains here if you front the app with your own domain.
# Example: ALLOWED_ORIGINS=https://chat.example.com,https://staging.example.com
# ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Abuse / cost limits. All optional — the defaults shown are what api/chat.js
# uses when the var is unset. Change them from the Vercel dashboard; no client
# redeploy needed.
# ---------------------------------------------------------------------------

# Requests per minute / per hour, per client IP. Set either to 0 to disable
# that window. NOTE: the limiter is in-process, so it bounds a single warm
# serverless instance rather than the whole deploy. It stops the obvious
# "point a script at the URL" abuse; for a hard global cap put Vercel KV or
# Upstash behind it.
# RATE_LIMIT_RPM=15
# RATE_LIMIT_RPH=120

# Per-request input ceilings. Rate limits bound how OFTEN you can call;
# these bound how EXPENSIVE one call can be. 0 disables the check.
# MAX_MESSAGES=100
# MAX_INPUT_CHARS=60000

# Hard ceiling on completion length sent upstream as max_tokens. A client may
# request less but never more. Set to 0 to send no cap at all (not advised —
# an uncapped completion is unbounded spend). Raise it if you use a reasoning
# model whose thinking tokens count against this budget and answers truncate.
# MAX_TOKENS_CAP=8192

# The server preset above is only handed out to requests that look like they
# came from a browser on an allowed origin (Origin or Referer must match), so
# nobody can curl your deploy for free tokens. Set this to 1 only if you have
# a trusted server-to-server caller that legitimately sends neither header.
# Requests that bring their own baseUrl + apiKey are unaffected either way.
# ALLOW_KEYLESS_API=0

# How long the function will stream before it stops itself and emits a
# "response truncated" frame. Must stay a few seconds BELOW the maxDuration
# set in vercel.json (60s), otherwise Vercel kills the function first and the
# browser sees a silently cut-off answer instead of an error. 0 disables the
# guard (only safe if maxDuration is effectively unlimited).
# STREAM_BUDGET_MS=55000
