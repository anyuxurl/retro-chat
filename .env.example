# RetroChat — environment variables.
# Copy this file to `.env.local` for local dev (gitignored), and configure
# the same vars in the Vercel dashboard for production deployment.

# Default upstream for the built-in mimo preset.
# Used by api/chat.js when the request body has no baseUrl/apiKey.
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=tp-your-key-here
